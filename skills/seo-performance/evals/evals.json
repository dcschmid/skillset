{
  "$comment": "Eval cases for the seo-performance skill. Each case: prompt to an agent + verifiable expectations against fixtures in tests/fixtures/. Run via tests/run.mjs (IT cases share fixtures).",
  "baseline": "2026-11-14",
  "cases": [
    { "id": "new-static-baseline", "framework": "static/Astro-like", "level": 1,
      "prompt": "audit tests/fixtures/site as a new site baseline",
      "expect": ["no false positives: title/description/viewport/charset/h1/canonical/lang on index.html", "report.json + report.md + snapshot written", "INP reported UNAVAILABLE not 0"], "test": "IT1, IT9" },
    { "id": "existing-nextjs-csr-gaps", "framework": "nextjs",
      "prompt": "existing project with sparse metadata + big images: diagnose, safe fixes only",
      "expect": ["metadata gaps via detectors on built HTML", "fix dry-run first, --apply for safe classes", "content/design untouched by safe fixes"], "test": "IT2/IT10" },
    { "id": "react-vite-csr-boundary", "framework": "react-vite",
      "prompt": "audit a CSR project honestly",
      "expect": ["source-level run states build-output absence", "no forced migration; pre-render/SSR as proposal", "no findings invented from shell HTML"], "test": "IT3" },
    { "id": "broken-site-detection", "framework": "static",
      "prompt": "find broken links, canonical and sitemap problems",
      "expect": ["fetch-error on dead routes", "canonical issues on about page", "sitemap dead + future lastmod entries", "reproducible evidence per finding"], "test": "IT4" },
    { "id": "perf-regression-gate", "framework": "any",
      "prompt": "did the change regress performance?",
      "expect": [">tolerance delta => regression", "within tolerance => noise", "compare output classifies, never silent"], "test": "IT5" },
    { "id": "schema-tiers", "framework": "any",
      "prompt": "validate JSON-LD and honesty vs visible copy",
      "expect": ["broken json fails valid-schema", "invisible claims flagged not-in-visible-text", "rich-result award stays UNDETERMINED offline"], "test": "IT6" },
    { "id": "i18n-hreflang", "framework": "any",
      "prompt": "audit de/en group",
      "expect": ["valid BCP47 codes not flagged", "crawl traverses locales", "reciprocity rule active"], "test": "IT7" },
    { "id": "external-readonly", "framework": "any",
      "prompt": "crawl external url politely",
      "expect": ["same-host only", "max-pages respected", "read-only GETs only"], "test": "IT8" },
    { "id": "no-apis", "framework": "any",
      "prompt": "audit without GSC/CrUX/PSI",
      "expect": ["full verdict from local evidence", "dataGaps declares INP/indexation/rich-results"], "test": "IT9" },
    { "id": "design-protection", "framework": "any",
      "prompt": "fixes must not break layout/content",
      "expect": ["apply touches safe attrs only", "headings/content preserved", "patch file + git diff reviewable"], "test": "IT2/IT10" },
    { "id": "ci-gate", "framework": "any",
      "prompt": "CI gate on broken site",
      "expect": ["non-zero exit on high findings", "lighthouserc + workflow scaffold via --init"], "test": "CI-gate test" }
  ],
  "successCriteria": "all IT cases pass offline deterministically via `node tests/run.mjs`; agent answers derived from report.json never contain numbers absent from it"
}
